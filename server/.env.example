# =============================================================================
# ServeEase Backend Environment Variables Template
# =============================================================================
# Instructions:
# 1. Copy this template to create your local environment file:
#    cp .env.example .env
# 2. Fill in the required variables (PORT, MONGODB_URI, JWT_SECRET).
# 3. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME (Required for backend startup)
# -----------------------------------------------------------------------------
# Port on which the Express API server listens (default: 5001)
PORT=5001

# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Allowed frontend origin for credentialed CORS cookies and requests
# Supports single URL or multiple comma-separated URLs (e.g. http://localhost:5174,http://localhost:5173)
FRONTEND_URL=http://localhost:5174
CLIENT_URL=http://localhost:5174

# Optional: Set to 'true' to allow server startup in degraded mode without MongoDB
# ALLOW_DEGRADED_MODE=false

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required for MongoDB operations & authentication)
# -----------------------------------------------------------------------------
# MongoDB Atlas connection string. Obtain from Atlas Dashboard:
# Database -> Connect -> Drivers -> Node.js
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/serveease?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Required for JWT token issuance & session validation)
# -----------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (min 32 characters in production)
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_32_character_minimum_random_secret_here

# -----------------------------------------------------------------------------
# 4. ADMIN BOOTSTRAP CREDENTIALS (Required ONLY when running `npm run bootstrap:admin`)
# -----------------------------------------------------------------------------
# These credentials are used strictly by the administrative provisioning script:
# `npm run bootstrap:admin`. They are NOT required for normal API server startup.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@serveease.com
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 5. OPTIONAL FUTURE INTEGRATIONS (Not implemented in Phase 2 / Not required)
# -----------------------------------------------------------------------------
# The following services are not currently active in Phase 2. They will not crash
# the server if omitted, but placeholders are provided for future phases.
#
# Optional Email / Notification Service (e.g. Nodemailer / SMTP):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=noreply@serveease.com
#
# Optional SMS / OTP Service (e.g. Twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
#
# Optional Maps / Geocoding Service (e.g. Google Maps API):
# GOOGLE_MAPS_API_KEY=
#
# Optional Media / Image Upload Storage (e.g. Cloudinary / AWS S3):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
