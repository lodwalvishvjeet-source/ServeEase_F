{
  "name": "serveease-server",
  "version": "1.0.0",
  "description": "ServeEase Backend API - College Mini-Project (MERN)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "bootstrap:admin": "node src/scripts/createAdmin.js",
    "bootstrap:admin:reset": "node src/scripts/createAdmin.js --reset-password",
    "seed:demo": "node src/scripts/seedDemoProviders.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js"
  },
  "keywords": [
    "serveease",
    "mern",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
